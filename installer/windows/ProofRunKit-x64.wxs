<?xml version="1.0" encoding="UTF-8"?>
<!--
  ProofRunKit 64-bit per-machine MSI (Refs #37, Refs #40).

  Built with WiX Toolset v4 (`wix build -arch x64`). Do not author a 32-bit
  package here; that is #38 / #39.

  UpgradeCode (stable for the x64 product line — do not change):
    {FB358981-835D-421D-8634-BA130FE100A2}

  The x86 installer (#38) uses a different UpgradeCode: {A31020BF-969A-4139-9FA1-82E044AC31F5}.
  ProductCode is generated by WiX on every build so MajorUpgrade can replace
  an older version that shares this UpgradeCode.

  Install destination: ProgramFiles64Folder\ProofRunKit
  (typically C:\Program Files\ProofRunKit).

  PATH: the AddToPath feature is Level 1 (included by default). Uncheck it in
  the feature tree, or pass REMOVE=AddToPath on a silent install, to skip it.

  Code signing is deferred (#41): this package is unsigned.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="ProofRunKit"
      Manufacturer="ProofRunKit"
      Version="$(var.PrkVersion)"
      UpgradeCode="FB358981-835D-421D-8634-BA130FE100A2"
      Language="1033"
      Scope="perMachine">

    <SummaryInformation
        Description="64-bit installer for the ProofRunKit test runner."
        Manufacturer="ProofRunKit" />

    <MajorUpgrade
        DowngradeErrorMessage="A newer version of ProofRunKit is already installed. Uninstall it before installing this version."
        Schedule="afterInstallInitialize" />

    <!-- Cabinet compression is standard MSI packaging, not an executable packer (#22). -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Patrick-W-McMahon/ProofRunKit" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Patrick-W-McMahon/ProofRunKit" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/Patrick-W-McMahon/ProofRunKit/releases" />
    <Property Id="ARPCOMMENTS" Value="64-bit ProofRunKit test runner. Licensed under the Apache License, Version 2.0." />

    <Launch
        Condition="VersionNT64"
        Message="The 64-bit ProofRunKit installer requires 64-bit Windows." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ProofRunKit" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="PrkStartMenuFolder" Name="ProofRunKit" />
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="ProofrunkitExe" Guid="*">
        <File Id="ProofrunkitExeFile"
              Source="$(var.PrkExePath)"
              Name="proofrunkit.exe"
              KeyPath="yes" />
      </Component>
      <Component Id="LicenseFile" Guid="*">
        <File Id="LicenseTxt"
              Source="$(var.PrkLicenseTxt)"
              Name="LICENSE.txt"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Component Id="StartMenuShortcuts" Directory="PrkStartMenuFolder" Guid="*">
      <Shortcut
          Id="PrkHelpShortcut"
          Name="ProofRunKit Help"
          Description="Show ProofRunKit command-line usage."
          Target="[System64Folder]cmd.exe"
          Arguments="/k &quot;[INSTALLFOLDER]proofrunkit.exe&quot; --help"
          WorkingDirectory="INSTALLFOLDER" />
      <File Id="PrkUrlShortcut"
            Source="$(var.PrkUrlShortcut)"
            Name="ProofRunKit on GitHub.url"
            KeyPath="yes" />
      <RemoveFolder Id="RemovePrkStartMenuFolder" On="uninstall" />
    </Component>

    <Component Id="PathComponent" Directory="INSTALLFOLDER" Guid="*">
      <Environment
          Id="PrkOnPath"
          Name="PATH"
          Value="[INSTALLFOLDER]"
          Permanent="no"
          Part="last"
          Action="set"
          System="yes" />
      <RegistryValue
          Root="HKLM"
          Key="Software\ProofRunKit"
          Name="InstallDir"
          Type="string"
          Value="[INSTALLFOLDER]"
          KeyPath="yes" />
    </Component>

    <!-- ProductFeature is required; AddToPath is a sibling so silent installs can
         omit it with REMOVE=AddToPath without touching the executable. -->
    <Feature
        Id="ProductFeature"
        Title="ProofRunKit"
        Description="The ProofRunKit command-line test runner and its license."
        Level="1"
        AllowAdvertise="no"
        ConfigurableDirectory="INSTALLFOLDER"
        TypicalDefault="install">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="StartMenuShortcuts" />
    </Feature>

    <Feature
        Id="AddToPath"
        Title="Add to PATH"
        Description="Add the ProofRunKit install directory to the system PATH. Recommended for command-line use. This is included by default."
        Level="1"
        AllowAdvertise="no"
        TypicalDefault="install">
      <ComponentRef Id="PathComponent" />
    </Feature>

    <WixVariable Id="WixUILicenseRtf" Value="$(var.PrkLicenseRtf)" />
    <ui:WixUI Id="WixUI_FeatureTree" />
  </Package>
</Wix>
