# EditorConfig for ProofRunKit. Based on the shared developing-bot configs.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{c,cc,cpp,cxx,h,hpp,hh,hxx,cmake,txt}]
indent_size = 4

[CMakeLists.txt]
indent_size = 4

[*.{py,pyi}]
indent_size = 4

[*.{sol}]
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{yml,yaml,json,html,css,js,jsx,mjs,cjs,ts,tsx,astro,lua}]
indent_size = 2

[*.{ps1,bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab

[*.{asm,s,S}]
indent_size = 4

[*.svg]
indent_size = 2
