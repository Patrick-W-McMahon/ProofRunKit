{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-msvc-x64-base",
      "hidden": true,
      "displayName": "Windows MSVC x64 (base)",
      "description": "Visual Studio 2026 (v18) generator, 64-bit MSVC toolset, MASM hot paths.",
      "generator": "Visual Studio 18 2026",
      "architecture": { "value": "x64", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-msvc-x64-debug",
      "inherits": "windows-msvc-x64-base",
      "displayName": "Windows MSVC x64 Debug",
      "cacheVariables": { "CMAKE_CONFIGURATION_TYPES": "Debug" }
    },
    {
      "name": "windows-msvc-x64-release",
      "inherits": "windows-msvc-x64-base",
      "displayName": "Windows MSVC x64 Release",
      "cacheVariables": { "CMAKE_CONFIGURATION_TYPES": "Release", "PRK_REPRODUCIBLE_BUILD": "ON" }
    },
    {
      "name": "unix-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "linux-debug",
      "inherits": "unix-base",
      "displayName": "Linux Debug (untested, future update #34)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-release",
      "inherits": "unix-base",
      "displayName": "Linux Release (untested, future update #34)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "macos-debug",
      "inherits": "unix-base",
      "displayName": "macOS Debug (untested, future update #35)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "macos-release",
      "inherits": "unix-base",
      "displayName": "macOS Release (untested, future update #35)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc-x64-debug", "configurePreset": "windows-msvc-x64-debug", "configuration": "Debug" },
    { "name": "windows-msvc-x64-release", "configurePreset": "windows-msvc-x64-release", "configuration": "Release" },
    { "name": "windows-msvc-x64-msi", "configurePreset": "windows-msvc-x64-release", "configuration": "Release", "targets": ["package-msi"] },
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "macos-debug", "configurePreset": "macos-debug" },
    { "name": "macos-release", "configurePreset": "macos-release" }
  ],
  "testPresets": [
    {
      "name": "windows-msvc-x64-debug",
      "configurePreset": "windows-msvc-x64-debug",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-msvc-x64-release",
      "configurePreset": "windows-msvc-x64-release",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
